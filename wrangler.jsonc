{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app12",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b3401f74-d80a-401d-9617-6c69157ef692","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f99da9a7a8964b2f91ac475031f4f218" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
